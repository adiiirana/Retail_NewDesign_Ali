<dx:SplashScreenWindow x:Class="OfflineRetailV2.FluentSplashScreen1"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                       Width="600" Height="356"
                       MinWidth="600" MinHeight="356"
                       MaxWidth="600" MaxHeight="356"
                       AllowAcrylic="False"
                       Background="#1F3A6E"
                       mc:Ignorable="d">

    <!-- New design start-up screen: store photo under a blue wash, centred logo + product name, amber divider,
         "Loading, please wait..." and an amber sliding progress bar; status text bottom-left.
         Bound to the DXSplashScreenViewModel created in App.xaml.cs (Title, Status). -->
    <Grid ClipToBounds="True">
        <!-- store photo -->
        <Rectangle>
            <Rectangle.Fill>
                <ImageBrush ImageSource="pack://application:,,,/OfflineRetailV2;component/Resources/Images/LoginStore.jpg"
                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="6" KernelType="Gaussian"/>
            </Rectangle.Effect>
        </Rectangle>
        <!-- blue wash, a little darker at the edges so the text stays crisp -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D92B5AA8" Offset="0"/>
                    <GradientStop Color="#C7244E96" Offset="0.55"/>
                    <GradientStop Color="#E61B3C78" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0.45"/>
                    <GradientStop Color="#55102650" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- centred content -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Image Source="pack://application:,,,/OfflineRetailV2;component/Resources/Icons/Logo.png" Stretch="Uniform" Height="64"
                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#0B1A3A"/>
                </Image.Effect>
            </Image>
            <TextBlock x:Name="PART_Title" Text="{Binding Title, TargetNullValue='XEPOS Retail', FallbackValue='XEPOS Retail'}"
                       FontFamily="pack://application:,,,/OfflineRetailV2;component/Resources/Fonts/#Poppins Bold"
                       FontSize="27" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" Color="#0B1A3A"/>
                </TextBlock.Effect>
            </TextBlock>
            <Border Width="46" Height="4" CornerRadius="2" Background="#F2A93B" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Loading, please wait..." FontFamily="pack://application:,,,/OfflineRetailV2;component/Resources/Fonts/#Poppins Medium"
                       FontSize="14.5" Foreground="#EAF0FB" HorizontalAlignment="Center" Margin="0,14,0,0"/>

            <!-- progress track with a sliding amber segment -->
            <Border Width="220" Height="7" CornerRadius="3.5" Background="#4DFFFFFF" Margin="0,16,0,0" ClipToBounds="True">
                <Rectangle Width="84" HorizontalAlignment="Left" RadiusX="3.5" RadiusY="3.5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFF7B84B" Offset="0"/>
                            <GradientStop Color="#FFF29A1F" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="barMove" X="-84"/>
                    </Rectangle.RenderTransform>
                    <!-- slide animation is started in code (constructor) -->
                </Rectangle>
            </Border>
        </StackPanel>

        <!-- status (from the view model) bottom-left -->
        <TextBlock x:Name="PART_Status" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="18,0,0,14"
                   FontFamily="pack://application:,,,/OfflineRetailV2;component/Resources/Fonts/#Poppins" FontSize="12" Foreground="#D6E0F5">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Text" Value="{Binding Status}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Null}"><Setter Property="Text" Value="Loading..."/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Text" Value="Loading..."/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</dx:SplashScreenWindow>
