                                            <Canvas Height="30"  Panel.ZIndex="6" >
                                                <cc:CustomButton Style="{DynamicResource MenuShowhidestyleNew}"   Width="30" Height="30" Canvas.Left="-15" Canvas.Top="0" x:Name="btnECHeader" >
