<Window x:Class="OfflineRetailV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OfflineRetailV2"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:prop="clr-namespace:OfflineRetailV2.Properties"
        xmlns:uc="clr-namespace:OfflineRetailV2.UserControls"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar"
        xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="XEPOS Retail 2024"   Height="768" Width="1024" FontFamily="{StaticResource OSRegular}"
        WindowStartupLocation="CenterScreen" Background="#26324F" MinHeight="768" MinWidth="1024" Loaded="Window_Loaded" Closing="Window_Closing">
    <!--WindowStyle="None" AllowsTransparency="True" WindowState="Maximized" MinHeight="768" MinWidth="1024"-->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/NewDesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Header info (user / till / time) is hidden while the login screen is showing -->
            <Style x:Key="ND.HideOnLogin" TargetType="{x:Type StackPanel}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=LoginGrid}" Value="Visible">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ND.HeaderText" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,18,0"/>
            </Style>
            <Style x:Key="ND.SupportTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource ND.TextDark}"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ND.SupportText" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource ND.TextBody}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="18"/>
            </Style>
            <Style x:Key="ND.SupportNumber" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Foreground" Value="{StaticResource ND.TextDark}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="-5" x:Name="Grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Background="{StaticResource ND.Navy}" Height="55" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=LoginBorder}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="18,0,6,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo, page title, cloud status pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="35.56" Height="27" Source="{StaticResource Logo}" VerticalAlignment="Center"/>
                    <TextBlock Text="XEPOS Retail" Margin="12,0,0,0" FontFamily="{StaticResource ND.Font.SemiBold}" FontSize="18" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Rectangle Width="1.2" Height="24" Fill="#4DFFFFFF" Margin="16,0,2,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtHeaderPageTitle" Text="|  Select Employee" Margin="10,0,0,0" FontFamily="{StaticResource ND.Font.Medium}" FontSize="15"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=LoginGrid}"/>
                    <Border x:Name="pnlCloudSyncStatus"
                            Visibility="Collapsed"
                            Background="#1AFFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1"
                            Height="28"
                            CornerRadius="14"
                            Padding="10,0"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Focusable="False"
                            SnapsToDevicePixels="True"
                            PreviewMouseLeftButtonDown="PnlCloudSyncStatus_PreviewMouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="cloudSyncStatusIcon"
                                  Width="14"
                                  Height="10"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Fill="White"
                                  Data="M 2,8 C 0.5,8 0,7 0,5.5 C 0,4 1,2.5 2.5,2 C 3,0.5 4.5,0 6.5,0 C 8.8,0 10.5,1.5 11,3.5 C 12.5,4 13.5,5.5 13.5,7.5 C 13.5,9.5 11.5,10.5 9.5,10.5 L 2,10.5 Z"/>
                            <Ellipse x:Name="cloudSyncStatusDot"
                                     Width="7"
                                     Height="7"
                                     Fill="#9CA3AF"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtCloudSyncStatus"
                                       Text="Connected"
                                       FontSize="13"
                                       FontFamily="{StaticResource ND.Font.Medium}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <!-- New design: Online / Offline pill (after login) -->
                    <Border x:Name="pnlHeaderOnline" Height="28" CornerRadius="14" Padding="11,0" Margin="12,0,0,0" VerticalAlignment="Center"
                            Background="#14FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="dotHeaderOnline" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtHeaderOnline" Text="Online" Margin="7,0,0,0" FontFamily="{StaticResource ND.Font.Medium}" FontSize="13"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="txtCloudSyncLastTime"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <cc:CustomTextBox Grid.Column="1" HorizontalAlignment="Left" Height="27" BorderThickness="0" Background="#2D64C0D9" CornerRadius="15" Margin="15,0,0,0"
                                  InfoText="Find Customer" FontSize="14" Icon="{StaticResource Search}" Visibility="Hidden" x:Name="SearchMemberTextBox" />
                <Button Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0" Style="{StaticResource ND.HeaderPill}" Content="FRONT OFFICE" Visibility="Hidden" x:Name="btnFrontOffice" ></Button>

                <!-- Signed-in information (shown after login) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="pnlHeaderInfo" Style="{StaticResource ND.HideOnLogin}">
                    <TextBlock Foreground="#5EC8F2" FontSize="14" x:Name="SoftwareNameTextBlock" VerticalAlignment="Center" Margin="0,0,20,0"
                               FontFamily="{StaticResource ND.Font.Medium}" Text="XEPOS Retail 2000 - Demo Version"/>
                    <Rectangle Width="1.2" Height="24" Fill="#4DFFFFFF" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LoggedInUserTextBlock" Style="{StaticResource ND.HeaderText}" FontFamily="{StaticResource ND.Font.SemiBold}" FontSize="14.5"
                               Text="{x:Static prop:Resources.NoLoggedInUser}" Margin="0,0,22,0"/>
                    <TextBlock x:Name="TillTextBlock" Style="{StaticResource ND.HeaderText}" Text="{x:Static prop:Resources.Till}" Margin="0,0,22,0"/>
                    <TextBlock x:Name="TimeTextBlock" Style="{StaticResource ND.HeaderText}" Text="13:59" Margin="0,0,22,0"/>
                    <TextBlock x:Name="DateTextBlock" Style="{StaticResource ND.HeaderText}" Text="" Margin="0,0,24,0"/>
                    <!-- Exit: shown while a screen registers a close action (Manage Register) -->
                    <Button x:Name="btnHeaderExit" Style="{StaticResource ND.OutlineButton}" Height="40" MinWidth="84" Padding="0" Visibility="Collapsed"
                            Margin="0,0,14,0" Click="BtnHeaderExit_Click" ToolTip="Close and sign out">
                        <StackPanel Orientation="Horizontal" Margin="16,0">
                            <Path Data="{StaticResource ND.Icon.Power}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" Width="14" Height="14"/>
                            <TextBlock Text="Exit" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Image x:Name="btnFullScreen" Width="24" Height="24" Source="{StaticResource FullScreenOut}" Stretch="UniformToFill"
                           Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonUp="BtnFullScreen_MouseLeftButtonUp"/>
                </StackPanel>

            </Grid>
        </Border>
        <!--<Ellipse VerticalAlignment="Top" HorizontalAlignment="Right" Fill="#49AC3D" Width="10.08" Height="10.08" Margin="3,0,3,0"/>-->

        <Grid Grid.Row="2" Visibility="Visible" x:Name="LoginGrid" Background="{StaticResource ND.Navy}">

            <!-- ===================== Select Employee (new design) ===================== -->
            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" x:Name="LoginBorder" Visibility="Visible" BorderThickness="0" SizeChanged="LoginBorder_SizeChanged"
                    Background="{StaticResource ND.Navy}" ClipToBounds="True">
                <Grid>
                    <!-- Store photo (composed from XeposDesign/assets/retail-store-clean*.png) + navy shade, as in 03-employee-login.html -->
                    <Rectangle Fill="{StaticResource ND.LoginStore}"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#D11D203D" Offset="0"/>
                                <GradientStop Color="#8C1D203D" Offset="0.36"/>
                                <GradientStop Color="#001D203D" Offset="0.52"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#A61D203D" Offset="0"/>
                                <GradientStop Color="#001D203D" Offset="0.35"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Design canvas: laid out at the mock-up's 1672 x 941 and scaled to the window by
                         LoginBorder_SizeChanged (width stretches so the passcode card stays on the right). -->
                    <Grid x:Name="LoginCanvas" Width="1672" Height="941" HorizontalAlignment="Left" VerticalAlignment="Top">

                        <!-- Header (88 tall) -->
                        <Border Height="88" VerticalAlignment="Top" Background="#DB1F2240">
                            <Grid Margin="28,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Logo}" Height="40" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Rectangle Width="1.5" Height="32" Fill="#4DFFFFFF" Margin="18,0,20,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Select Employee" FontFamily="{StaticResource ND.Font.Bold}" FontSize="24" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Border x:Name="pnlLoginOnline" Height="32" CornerRadius="16" Padding="12,0" Margin="18,0,0,0" VerticalAlignment="Center"
                                            Background="#1AFFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1.2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="dotLoginOnline" Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtLoginOnline" Text="Online" Margin="8,0,0,0" FontFamily="{StaticResource ND.Font.SemiBold}" FontSize="14"
                                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="pnlLoginNav" VerticalAlignment="Center">
                                    <RadioButton x:Name="rbNavAdmin" GroupName="LoginNav" Style="{StaticResource ND.NavRadio}" Checked="RbNavAdmin_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ND.Icon.UserCog}" Style="{StaticResource ND.IconPath}" Width="22" Height="22"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <TextBlock Text="Admin" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbNavOrdering" GroupName="LoginNav" Style="{StaticResource ND.NavRadio}" Checked="RbNavOrdering_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ND.Icon.Cart}" Style="{StaticResource ND.IconPath}" Width="22" Height="22"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <TextBlock Text="Ordering" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbNavRegister" GroupName="LoginNav" Style="{StaticResource ND.NavRadio}" Checked="RbNavRegister_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ND.Icon.Layers}" Style="{StaticResource ND.IconPath}" Width="22" Height="22"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            <TextBlock Text="Manage Register" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <Button x:Name="btnModule_T" Style="{StaticResource ND.NavButton}" Click="btnModule_T_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ND.Icon.Headset}" Style="{StaticResource ND.IconPath}" Width="22" Height="22"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="Technical Support" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnLoginExit" Style="{StaticResource ND.HeaderIconButton}" Click="ExitButton_Click" ToolTip="{x:Static prop:Resources.ExitSoftware}">
                                        <Path Data="{StaticResource ND.Icon.LogOut}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="1.9" Width="22" Height="22"/>
                                    </Button>
                                </StackPanel>
                                <!-- ===================== Technical Support popup ===================== -->
                                <Popup x:Name="popupTooltip" AllowsTransparency="True" PlacementTarget="{Binding ElementName=pnlLoginNav}" Placement="Bottom"
                                       VerticalOffset="4" Width="572" StaysOpen="False" Opened="PopupTooltip_Opened" Closed="PopupTooltip_Closed">
                                    <Border Background="#FFFFFF" CornerRadius="10" Margin="8,0,8,12" Padding="20,18,20,20" Effect="{StaticResource ND.Shadow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="1.15*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Live chat -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource ND.Icon.Grid}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Blue}" Width="18" Height="18"/>
                                                    <TextBlock Text="Live Chat" Style="{StaticResource ND.SupportTitle}"/>
                                                </StackPanel>
                                                <TextBlock Text="To speak to us online please click below to open our live chat" Style="{StaticResource ND.SupportText}" Margin="0,10,0,16"/>
                                                <Button Style="{StaticResource ND.PrimaryButton}" HorizontalAlignment="Left" Height="40" Width="130" FontSize="13" Click="Button_Click_3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource ND.Icon.Person}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Blue}" Width="11" Height="13"/>
                                                        <TextBlock Text="Live Chat" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Telephone -->
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource ND.Icon.Grid}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Blue}" Width="18" Height="18"/>
                                                    <TextBlock Text="Telephone" Style="{StaticResource ND.SupportTitle}"/>
                                                </StackPanel>
                                                <TextBlock Text="Call our Technical Support team on" Style="{StaticResource ND.SupportText}" Margin="0,10,0,0"/>
                                                <TextBlock Text="0121 387 0007" Style="{StaticResource ND.SupportNumber}"/>
                                            </StackPanel>

                                            <!-- WhatsApp -->
                                            <StackPanel Grid.Column="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource ND.Icon.Grid}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Blue}" Width="18" Height="18"/>
                                                    <TextBlock Text="WhatsApp" Style="{StaticResource ND.SupportTitle}"/>
                                                </StackPanel>
                                                <TextBlock Text="WhatsApp us on" Style="{StaticResource ND.SupportText}" Margin="0,10,0,0"/>
                                                <TextBlock Text="01213 870 007" Style="{StaticResource ND.SupportNumber}"/>
                                                <TextBlock Text="Or scan the QR code below" Style="{StaticResource ND.SupportText}" Margin="0,12,0,8"/>
                                                <!-- QR code with corner brackets -->
                                                <Grid Width="132" Height="132" HorizontalAlignment="Left">
                                                    <Path Stroke="{StaticResource ND.NavyButton}" StrokeThickness="3" Data="M0,22 V0 H22 M110,0 H132 V22 M132,110 V132 H110 M22,132 H0 V110"/>
                                                    <Image Source="{DynamicResource qrcode}" Margin="8"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <!-- Welcome copy: first line sits level with "Enter Passcode" in the pad -->
                        <StackPanel Margin="82,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock Text="W&#x2009;&#x200A;E&#x2009;&#x200A;L&#x2009;&#x200A;C&#x2009;&#x200A;O&#x2009;&#x200A;M&#x2009;&#x200A;E&#x2003;T&#x2009;&#x200A;O&#x2003;X&#x2009;&#x200A;E&#x2009;&#x200A;P&#x2009;&#x200A;O&#x2009;&#x200A;S&#x2003;R&#x2009;&#x200A;E&#x2009;&#x200A;T&#x2009;&#x200A;A&#x2009;&#x200A;I&#x2009;&#x200A;L" FontFamily="{StaticResource ND.Font.Bold}" FontSize="15" Foreground="#D8DBF0"/>
                            <Rectangle Width="70" Height="4" Fill="#F2A93B" HorizontalAlignment="Left" Margin="0,16,0,18" RadiusX="2" RadiusY="2"/>
                            <TextBlock Text="Select Employee" FontFamily="{StaticResource ND.Font.ExtraBold}" FontSize="54" Foreground="#FFFFFF"/>
                            <TextBlock Text="Choose your account and enter your passcode" FontFamily="{StaticResource ND.Font.Regular}" FontSize="21" Foreground="#CFD2EA" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- First-run hint (no employees yet) -->
                        <StackPanel x:Name="pnllogininfo" Visibility="Hidden" Margin="82,592,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="900">
                            <TextBlock Text="Password: 1111" Foreground="#FFFFFF" FontFamily="{StaticResource ND.Font.SemiBold}" FontSize="17"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#CFD2EA" FontFamily="{StaticResource ND.Font.Regular}" FontSize="15" Margin="0,2,0,0"
                                       Text="Please remember password. It is the password of the Store Owner user. You may change it anytime from the Employee Setup."/>
                        </StackPanel>

                        <!-- Employee area: from under the welcome copy to above the footer; pages (up to 4 x 2) are centred in it -->
                        <Grid Margin="52,330,0,64" VerticalAlignment="Stretch" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="888"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnEmpPrev" Grid.Column="0" Style="{StaticResource ND.RoundArrowButton}" Width="52" Height="52" Background="#FFFFFF"
                                    Click="BtnEmpPrev_Click">
                                <Path Data="{StaticResource ND.Icon.ChevronLeft}" Style="{StaticResource ND.IconPath}" Stroke="#1B1D33" StrokeThickness="2.2" Width="9" Height="15"/>
                            </Button>
                            <ScrollViewer x:Name="ScrollViewerEmp" Grid.Column="2" Focusable="False" FocusVisualStyle="{x:Null}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly" PanningRatio="1" PanningDeceleration="2"
                                          ManipulationBoundaryFeedback="ScrlViewer_ManipulationBoundaryFeedback" ScrollChanged="ScrollViewerEmp_ScrollChanged">
                                <StackPanel x:Name="pnlEmp" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                            </ScrollViewer>
                            <Button x:Name="btnEmpNext" Grid.Column="4" Style="{StaticResource ND.RoundArrowButton}" Width="52" Height="52" Background="#FFFFFF"
                                    Click="BtnEmpNext_Click">
                                <Path Data="{StaticResource ND.Icon.ChevronRight}" Style="{StaticResource ND.IconPath}" Stroke="#1B1D33" StrokeThickness="2.2" Width="9" Height="15"/>
                            </Button>
                        </Grid>

                        <!-- Footer (bottom 24) -->
                        <TextBlock x:Name="txtLoginFooter" Margin="82,0,0,24" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                   FontFamily="{StaticResource ND.Font.Regular}" FontSize="14" Foreground="#9DA2C5" Text="XEPOS Retail"/>

                        <!-- Passcode pad: full height on the right (top 116, bottom 48); the keys grow into the extra height -->
                        <Border Width="546" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="0,116,30,48" Background="#FFFFFF" CornerRadius="26" Padding="36,34,36,28"
                                Effect="{StaticResource ND.ShadowLarge}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource ND.Icon.Lock}" Style="{StaticResource ND.IconPath}" Stroke="#1B1D33" StrokeThickness="2" Width="19" Height="22"/>
                                    <TextBlock Text="Enter Passcode" Margin="12,0,0,0" FontFamily="{StaticResource ND.Font.ExtraBold}" FontSize="26" Foreground="#1B1D33" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="txtLoggingInAs" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="{StaticResource ND.Font.Regular}" FontSize="16" Foreground="#4B4F6B"
                                           Text="Select your account to continue"/>
                                <!-- Not in the mock-up: Clock In / Out mode and Sales Snapshot. Logging in happens on the 4th digit. -->
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button x:Name="btnClockIn" Style="{StaticResource ND.LinkButton}" Click="BtnClockAction_Click"
                                            ToolTip="Tap, then enter your passcode to clock in, take a break or clock out">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ND.Icon.Clock}" Style="{StaticResource ND.IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="txtClockLink" Text="Clock In / Out" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="·" Margin="16,0" Foreground="#C5C9DA" FontSize="16" VerticalAlignment="Center"/>
                                    <Button x:Name="btnSalesSnapshotLink" Style="{StaticResource ND.LinkButton}" Click="BtnSalesSnapshotLink_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ND.Icon.BarChart}" Style="{StaticResource ND.IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Margin="0,0,7,0"/>
                                            <TextBlock Text="Sales Snapshot" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- kept for code references; the link above covers all clock actions -->
                                    <Button x:Name="btnStartBreak" Visibility="Collapsed"/>
                                    <Button x:Name="btnClockOut" Visibility="Collapsed"/>
                                </StackPanel>
                                <cc:KeyPadPasswordControl x:Name="KeyPadPasswordControl" PasswordChanged="KeyPadPasswordControl_PasswordChanged"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Legacy side menu (Show/Hide + Exit). Kept for code-behind references; the header X replaces it. -->
                    <Grid x:Name="GridB" Visibility="Collapsed" Style="{DynamicResource GrdBkColor}" Grid.Column="3" Margin="0,0,0,5"  >


                        <Grid  Panel.ZIndex="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

