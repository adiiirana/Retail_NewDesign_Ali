                                                <TextBlock  Text="Exit" VerticalAlignment="Center" FontFamily="{StaticResource OSRegular}" Padding="10" Foreground="White" FontSize="12"></TextBlock>
                                            </Grid>

                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </DockPanel>



