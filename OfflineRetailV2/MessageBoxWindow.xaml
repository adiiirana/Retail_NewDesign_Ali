<Window x:Class="OfflineRetailV2.MessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OfflineRetailV2"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="" Width="480" SizeToContent="Height" MinHeight="230" WindowStyle="None"  ResizeMode="NoResize"  WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"  Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/NewDesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- header icons, picked in code from the MessageBoxImage -->
            <Geometry x:Key="MbIconInfo">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M12,11 V16.5 M12,7.6 V7.7</Geometry>
            <Geometry x:Key="MbIconQuestion">M12,21 A9,9 0 1 0 12,3 A9,9 0 1 0 12,21 Z M9.5,9.5 A2.5,2.5 0 1 1 13,11.8 C12.3,12.2 12,12.7 12,13.5 M12,17 V17.3</Geometry>
            <Geometry x:Key="MbIconWarning">M12,3.5 L21.5,20 H2.5 Z M12,10 V14.5 M12,17.2 V17.3</Geometry>
            <Geometry x:Key="MbIconError">M12,21 A9,9 0 1 0 12,3 A9,9 0 1 0 12,21 Z M9,9 L15,15 M15,9 L9,15</Geometry>
        </ResourceDictionary>
    </Window.Resources>

    <!-- New design message box: navy header (icon, caption, close), centred message, Cancel / Confirm style buttons.
         Names used by the code-behind are unchanged (TitleTextBlock, ContentTextBlock, Left/Center/RightButton, ModalWindow). -->
    <Grid Margin="12">
        <!-- kept for the code-behind (sets its CloseCommand); the visible chrome is drawn below -->
        <cc:ModalWindow x:Name="ModalWindow" Visibility="Collapsed"/>

        <Border CornerRadius="18" Background="#FFFFFF" Effect="{StaticResource ND.ShadowLarge}"/>
        <Border CornerRadius="18" x:Name="dlgBody">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== header ===== -->
                <Grid Grid.Row="0">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E2246" Offset="0"/>
                                <GradientStop Color="#2A2F5C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle HorizontalAlignment="Right" Width="280" Opacity="0.85">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/OfflineRetailV2;component/Resources/Images/LoginStore.jpg"
                                        Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Bottom" Viewbox="0.42,0.78,0.5,0.22"/>
                        </Rectangle.Fill>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Grid Margin="20,0,14,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="iconBadge" Width="36" Height="36" CornerRadius="18" Background="#FFFFFF" Margin="0,0,14,0">
                            <Path x:Name="iconPath" Data="{StaticResource MbIconInfo}" Style="{StaticResource ND.IconPath}" Stroke="#3B6FE0" StrokeThickness="2" Width="20" Height="20"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="TitleTextBlock" Text="Confirm" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource ND.Font.Bold}" FontSize="18" Foreground="#FFFFFF"/>
                        <Button Grid.Column="2" Style="{StaticResource ND.DialogCloseButton}" Width="36" Height="36" Click="CloseButton_Click" ToolTip="Close"/>
                    </Grid>
                </Grid>

                <!-- ===== message ===== -->
                <TextBlock Grid.Row="1" x:Name="ContentTextBlock" Text="Can not Connect to Database." TextAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{StaticResource ND.Font.Regular}" FontSize="16" Foreground="#1B1D33" LineHeight="23"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,22,28,18"/>

                <!-- ===== buttons (columns / spans are set by the code-behind for each button set) ===== -->
                <Grid Grid.Row="2" Margin="20,4,20,20" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Grid.ColumnSpan="3" x:Name="LeftButton" Content="No" FontSize="16" HorizontalContentAlignment="Center"
                            Click="LeftButton_Click" Style="{StaticResource ND.PosSoftButton}"/>
                    <Button Grid.Column="4" Grid.ColumnSpan="3" x:Name="CenterButton" Content="No" FontSize="16" HorizontalContentAlignment="Center"
                            Click="CenterButton_Click" Style="{StaticResource ND.PosSoftButton}"/>
                    <Button Grid.Column="8" Grid.ColumnSpan="3" x:Name="RightButton" Content="Yes" FontSize="16"
                            Click="RightButton_Click" Style="{StaticResource ND.SuccessButton}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
