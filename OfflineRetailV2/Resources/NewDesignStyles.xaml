    <!-- Function tile: light card, icon above the label (the label is the button's TextBlock content) -->
    <Style x:Key="ND.PosOptionTile" TargetType="{x:Type Button}">
        <Style.Resources>
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="#EEF2F7"/>
        <Setter Property="Foreground" Value="{StaticResource ND.TextDark}"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True" Padding="6,8,6,6">
                        <StackPanel VerticalAlignment="Center">
                            <Path Data="{DynamicResource ND.TileIcon}" Style="{StaticResource ND.IconPath}"
                                  Stroke="{TemplateBinding Foreground}" Width="21" Height="21" Margin="0,0,0,7"/>
                            <ContentPresenter HorizontalAlignment="Center">
                                <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E3E9F2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ND.KeyPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red outlined full-width action (Clear Order) -->
    <Style x:Key="ND.DangerOutlineButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#C0392B"/>
        <Setter Property="BorderBrush" Value="#C0392B"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FDF0EE"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F9DEDA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navy outlined button on light backgrounds ("POS options" opener) -->
    <Style x:Key="ND.OutlineNavyButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource ND.TextDark}"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ND.Navy}" BorderThickness="1.5" CornerRadius="8" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#EEF2F7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ND.KeyBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain X close button for light modals -->
    <Style x:Key="ND.ModalCloseButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <Path Data="{StaticResource ND.Icon.Close}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.TextDark}" StrokeThickness="1.8" Width="13" Height="13"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#EEF2F7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text toggle used for "More functions" in the POS options modal -->
    <Style x:Key="ND.LinkToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{StaticResource ND.TextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                        <Path x:Name="chev" Data="{StaticResource ND.Icon.ChevronDown}" Style="{StaticResource ND.IconPath}" Stroke="{TemplateBinding Foreground}"
                              Width="10" Height="6" Margin="7,1,0,0" RenderTransformOrigin="0.5,0.5"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chev" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- White card used for POS category / product tiles (applied from code) -->
    <ControlTemplate x:Key="ND.PosCardTemplate" TargetType="{x:Type Button}">
        <Border x:Name="bd" Margin="3" Background="{TemplateBinding Background}" CornerRadius="10"
                BorderBrush="#E1E7EF" BorderThickness="1" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
            </ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#C3CDDB"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EEF2F7"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- Navy Pay button (POS) -->
    <Style x:Key="ND.PayButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ND.NavyButton}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3C4769"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ND.NavyPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Login photo (chef plating pasta). Viewbox crops the navy band at the top of the source image. -->
    <BitmapImage x:Key="ND.LoginPhotoSource" UriSource="/Resources/Images/LoginBackground.jpg"/>
    <ImageBrush x:Key="ND.LoginPhoto" ImageSource="{StaticResource ND.LoginPhotoSource}" Stretch="UniformToFill"
                AlignmentX="Left" AlignmentY="Center" Viewbox="0,0.035,1,0.965" ViewboxUnits="RelativeToBoundingBox"/>
    <!-- Close-up on hand + plate for the Manage Register hero -->
    <ImageBrush x:Key="ND.LoginPhotoHero" ImageSource="{StaticResource ND.LoginPhotoSource}" Stretch="UniformToFill"
                Viewbox="0.05,0.05,0.72,0.9" ViewboxUnits="RelativeToBoundingBox"/>
</ResourceDictionary>
