<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        XEPOS new design (XEPOS_UI_Screens_Overview.pdf) - shared palette, icons and styles.
        Merged locally by MainWindow, KeyPadPasswordControl and frmCloseoutDlg_CashOut so it
        survives the Light/Dark theme switch (which clears Application.Resources).
    -->

    <!-- ===================== Fonts ===================== -->
    <FontFamily x:Key="ND.Font.Regular">/Resources/Fonts/#Poppins</FontFamily>
    <FontFamily x:Key="ND.Font.Medium">/Resources/Fonts/#Poppins Medium</FontFamily>
    <FontFamily x:Key="ND.Font.SemiBold">/Resources/Fonts/#Poppins SemiBold</FontFamily>
    <FontFamily x:Key="ND.Font.Bold">/Resources/Fonts/#Poppins Bold</FontFamily>

    <!-- ===================== Palette ===================== -->
    <SolidColorBrush x:Key="ND.Navy" Color="#26324F"/>
    <SolidColorBrush x:Key="ND.NavyButton" Color="#323C5B"/>
    <SolidColorBrush x:Key="ND.NavyPressed" Color="#1E2840"/>
    <SolidColorBrush x:Key="ND.Orange" Color="#E8961C"/>
    <SolidColorBrush x:Key="ND.Yellow" Color="#F8C95A"/>
    <SolidColorBrush x:Key="ND.PageBg" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="ND.KeyBg" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="ND.KeyPressed" Color="#D3DBE8"/>
    <SolidColorBrush x:Key="ND.InputBg" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="ND.Border" Color="#D8DEE8"/>
    <SolidColorBrush x:Key="ND.TextDark" Color="#26324F"/>
    <SolidColorBrush x:Key="ND.TextBody" Color="#5B6478"/>
    <SolidColorBrush x:Key="ND.TextMuted" Color="#8A93A6"/>
    <SolidColorBrush x:Key="ND.White" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ND.Blue" Color="#3DB6ED"/>
    <SolidColorBrush x:Key="ND.BlueTint" Color="#E8F7FC"/>
    <SolidColorBrush x:Key="ND.Purple" Color="#9A60A5"/>
    <SolidColorBrush x:Key="ND.PurpleTint" Color="#F5ECF7"/>
    <SolidColorBrush x:Key="ND.OrangeTint" Color="#FFF4E5"/>
    <SolidColorBrush x:Key="ND.Teal" Color="#2AA7A1"/>
    <SolidColorBrush x:Key="ND.TealTint" Color="#E6F7F6"/>
    <SolidColorBrush x:Key="ND.Green" Color="#3E9B6B"/>
    <SolidColorBrush x:Key="ND.GreenTint" Color="#EAF6EF"/>
    <SolidColorBrush x:Key="ND.Amber" Color="#D9893A"/>
    <SolidColorBrush x:Key="ND.AmberTint" Color="#FCF1E4"/>
    <SolidColorBrush x:Key="ND.Red" Color="#D9605A"/>
    <SolidColorBrush x:Key="ND.RedTint" Color="#FDEEED"/>
    <SolidColorBrush x:Key="ND.Check" Color="#4CAE43"/>

    <DropShadowEffect x:Key="ND.Shadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#1B2540"/>
    <DropShadowEffect x:Key="ND.ShadowSoft" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#1B2540"/>

    <!-- ===================== Line icons (24x24 grid, drawn as strokes) ===================== -->
    <Geometry x:Key="ND.Icon.Person">M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 Z M4,21 C4,16.6 7.6,14.2 12,14.2 C16.4,14.2 20,16.6 20,21</Geometry>
    <Geometry x:Key="ND.Icon.Cart">M2,3 H5 L7.6,15 H18 L20.4,7 H6 M9,19.5 A1.2,1.2 0 1 0 9,19.49 M17,19.5 A1.2,1.2 0 1 0 17,19.49</Geometry>
    <Geometry x:Key="ND.Icon.Layers">M12,3 L21,8 L12,13 L3,8 Z M3,12.5 L12,17.5 L21,12.5 M3,16.5 L12,21.5 L21,16.5</Geometry>
    <Geometry x:Key="ND.Icon.Headset">M4,15 V12 A8,8 0 0 1 20,12 V15 M4,14 H7.5 V20 H5.5 A1.5,1.5 0 0 1 4,18.5 Z M20,14 H16.5 V20 H18.5 A1.5,1.5 0 0 0 20,18.5 Z</Geometry>
    <Geometry x:Key="ND.Icon.Close">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="ND.Icon.Lock">M5.5,11 H18.5 V21 H5.5 Z M8.5,11 V7.5 A3.5,3.5 0 0 1 15.5,7.5 V11</Geometry>
    <Geometry x:Key="ND.Icon.Clock">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M12,7 V12 L15.5,14</Geometry>
    <Geometry x:Key="ND.Icon.Coffee">M4,9 H16 V13.5 A5.5,5.5 0 0 1 10.5,19 H9.5 A5.5,5.5 0 0 1 4,13.5 Z M16,10 H17.5 A2.2,2.2 0 0 1 17.5,14.4 H16 M3,21.5 H17 M7.5,3 V6 M10.5,3 V6 M13.5,3 V6</Geometry>
    <Geometry x:Key="ND.Icon.Backspace">M8,5 H21 V19 H8 L2,12 Z M11.5,9 L16.5,15 M16.5,9 L11.5,15</Geometry>
    <Geometry x:Key="ND.Icon.Menu">M4,6.5 H20 M4,12 H20 M4,17.5 H20</Geometry>
    <Geometry x:Key="ND.Icon.ArrowRight">M4,12 H20 M14,6 L20,12 L14,18</Geometry>
    <Geometry x:Key="ND.Icon.ChevronLeft">M15,5 L8,12 L15,19</Geometry>
    <Geometry x:Key="ND.Icon.ChevronRight">M9,5 L16,12 L9,19</Geometry>
    <Geometry x:Key="ND.Icon.ChevronDown">M5,9 L12,16 L19,9</Geometry>
    <Geometry x:Key="ND.Icon.Power">M12,3 V11 M7,6.5 A7.5,7.5 0 1 0 17,6.5</Geometry>
    <Geometry x:Key="ND.Icon.Calendar">M4,6 H20 V20 H4 Z M4,10 H20 M8,3 V7 M16,3 V7</Geometry>
    <Geometry x:Key="ND.Icon.Swap">M4,8 H19 M15,4 L19,8 L15,12 M20,16 H5 M9,12 L5,16 L9,20</Geometry>
    <Geometry x:Key="ND.Icon.Report">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9.5,17.5 V14.5 M12.5,17.5 V11.5 M15.5,17.5 V13.5</Geometry>
    <Geometry x:Key="ND.Icon.AreaChart">M3,20.5 H21 M3,4 V20.5 M5,18 L9.5,11.5 L13,14.5 L20,7 V18 Z</Geometry>
    <Geometry x:Key="ND.Icon.Printer">M7,9 V3 H17 V9 M7,17 H4 V9 H20 V17 H17 M7,13.5 H17 V21 H7 Z</Geometry>
    <Geometry x:Key="ND.Icon.Edit">M4,20 H8 L19,9 L15,5 L4,16 Z M13,7 L17,11</Geometry>
    <Geometry x:Key="ND.Icon.Grid">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z</Geometry>
    <Geometry x:Key="ND.Icon.BarChart">M5,20 V11 M10,20 V5 M15,20 V13 M20,20 V8 M3,20.5 H22</Geometry>
    <Geometry x:Key="ND.Icon.Eraser">M4,15 L13,6 L19,12 L12,19 H8 Z M9,10 L15,16 M12,19 H20</Geometry>
    <Geometry x:Key="ND.Icon.Fullscreen">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15</Geometry>

    <!-- Path used for every icon; colour comes from Stroke (bound to Foreground where useful) -->
    <Style x:Key="ND.IconPath" TargetType="{x:Type Path}">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Header navigation (Admin / Ordering / Manage Register / Technical Support) ===================== -->
    <ControlTemplate x:Key="ND.NavTemplate" TargetType="{x:Type ButtonBase}">
        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1.2" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
            </ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ND.NavBase" TargetType="{x:Type ButtonBase}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{StaticResource ND.NavTemplate}"/>
    </Style>

    <!-- Section selector: checked = white pill with navy text -->
    <Style x:Key="ND.NavRadio" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ND.NavBase}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource ND.Navy}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Plain nav button: Tag="Active" shows the selected look (used while the support popup is open) -->
    <Style x:Key="ND.NavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ND.NavBase}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource ND.Navy}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Square icon-only header button (close / full screen) -->
    <Style x:Key="ND.HeaderIconButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.2" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#77FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Keypad ===================== -->
    <Style x:Key="ND.KeyButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource ND.KeyBg}"/>
        <Setter Property="Foreground" Value="{StaticResource ND.TextDark}"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#DFE5EF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ND.KeyPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navy primary action (LOGIN, Live Chat) -->
    <Style x:Key="ND.PrimaryButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource ND.NavyButton}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#3C4769"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ND.NavyPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tinted soft button (Clock In / Start Break / Clock Out). Set Background (tint) + Foreground (accent). -->
    <Style x:Key="ND.SoftButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round grey carousel arrow -->
    <Style x:Key="ND.RoundArrowButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="#D9DDE4"/>
        <Setter Property="Foreground" Value="{StaticResource ND.Navy}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Manage Register ===================== -->
    <!-- Action tile: white card, coloured accent bar on the left (BorderBrush), chevron on the right -->
    <Style x:Key="ND.Tile" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="card" Background="{TemplateBinding Background}" CornerRadius="12" Effect="{StaticResource ND.ShadowSoft}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="12,0,0,12"/>
                            <ContentPresenter Grid.Column="1" Margin="22,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                            </ContentPresenter>
                            <Path Grid.Column="2" Data="{StaticResource ND.Icon.ChevronRight}" Style="{StaticResource ND.IconPath}"
                                  Stroke="#9AA3B5" Width="9" Height="16" Margin="0,0,26,0"/>
                        </Grid>
                        <Border x:Name="hover" CornerRadius="12" Background="#0A26324F" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Background" Value="#1426324F"/>
                            <Setter TargetName="hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ND.TileTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource ND.TextDark}"/>
    </Style>
    <Style x:Key="ND.TileSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Regular}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource ND.TextMuted}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Outlined white button on the hero (Exit) -->
    <Style x:Key="ND.OutlineButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource ND.Navy}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#E6FFFFFF" BorderThickness="1.5" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#323C5B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ND.NavyPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Wide navy bar with yellow swoosh and round arrow (Open / Close Register) -->
    <Style x:Key="ND.RegisterBarButton" TargetType="{x:Type Button}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource ND.Navy}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="210" Height="44" Stretch="Fill"
                                  Fill="{StaticResource ND.Yellow}" Data="M0,44 C60,40 110,0 210,2 L210,44 Z"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border HorizontalAlignment="Right" Width="42" Height="42" CornerRadius="21" Background="#FFFFFF" Margin="0,0,22,0">
                                <Path Data="{StaticResource ND.Icon.ArrowRight}" Style="{StaticResource ND.IconPath}"
                                      Stroke="{StaticResource ND.Navy}" Width="18" Height="14"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2E3B5D"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ND.NavyPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simple round radio (Consolidated / By Terminal) -->
    <Style x:Key="ND.Radio" TargetType="{x:Type RadioButton}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Foreground" Value="{StaticResource ND.TextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Regular}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,30,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse Stroke="#8A93A6" StrokeThickness="1.2" Fill="#FFFFFF"/>
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource ND.Navy}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch (Print in Receipt Printer) -->
    <Style x:Key="ND.ToggleSwitch" TargetType="{x:Type CheckBox}">
        <Style.Resources>
            <!-- shield content from the app-wide implicit TextBlock style so Foreground/FontFamily inherit -->
            <Style TargetType="{x:Type TextBlock}"/>
        </Style.Resources>
        <Setter Property="Foreground" Value="{StaticResource ND.TextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource ND.Font.Regular}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="38" Height="20" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="10" Background="#E2E2E2"/>
                            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0"
                                     Effect="{StaticResource ND.ShadowSoft}"/>
                        </Grid>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                        </ContentPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource ND.Blue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
