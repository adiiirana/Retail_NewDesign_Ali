<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_POSApptBookBrw"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfflineRetailV2.UserControls.POSSection"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        xmlns:dxsch="http://schemas.devexpress.com/winfx/2008/xaml/scheduling"
        xmlns:dxschv="http://schemas.devexpress.com/winfx/2008/xaml/scheduling/visual"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen"
        Title="" Foreground="White"   Height="720" Width="1024" Loaded="Window_Loaded" >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/NewDesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!--region #AppointmentContentTemplate-->
        <DataTemplate x:Key="appointmentContentTemplate">
            <dxschv:AppointmentContentPanel>
                <dxschv:AppointmentContentPanel.IntervalSubject>
                    <dxschv:AppointmentIntervalSubjectPresenter/>
                </dxschv:AppointmentContentPanel.IntervalSubject>
                <dxschv:AppointmentContentPanel.Location>
                    <dxschv:AppointmentLocationPresenter FontWeight="Normal" Foreground="BlueViolet" />
                </dxschv:AppointmentContentPanel.Location>
                <dxschv:AppointmentContentPanel.Description>
                    <StackPanel>
                        <dxschv:FastTextBlock  FontWeight="Normal" Foreground="Black"/>
                        <dxschv:AppointmentDescriptionPresenter FontWeight="Normal" Margin="0,1,0,0" WordWrap="True"/>
                    </StackPanel>
                </dxschv:AppointmentContentPanel.Description>
                <dxschv:AppointmentContentPanel.Images>
                    <dxschv:AppointmentImagesPanel/>
                </dxschv:AppointmentContentPanel.Images>
            </dxschv:AppointmentContentPanel>
        </DataTemplate>
        <!--endregion #AppointmentContentTemplate-->

        
        <Style x:Key="appointmentStyle" TargetType="dxschv:AppointmentControl">
            <Setter Property="ShowInterval" Value="True"/>
            <Setter Property="ShowDescription" Value="True"/>
            
        </Style>
        <!--endregion #AppointmentControlStyle-->
            <Geometry x:Key="ApIconCalendar">M4,6 H20 V20 H4 Z M4,10 H20 M8,3 V7 M16,3 V7 M8,13.5 H9 M12,13.5 H13 M16,13.5 H17 M8,16.5 H9 M12,16.5 H13</Geometry>

            <Style x:Key="ApLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#1B1D33"/>
                <Setter Property="Margin" Value="2,0,0,5"/>
            </Style>
            <Style x:Key="ApField" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderBrush" Value="#C9CEDC"/>
                <Setter Property="BorderThickness" Value="1.2"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Padding" Value="6,0,4,0"/>
            </Style>
            <Style x:Key="ApEditor" TargetType="{x:Type dxe:BaseEdit}">
                <Setter Property="ShowBorder" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Regular}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#1B1D33"/>
            </Style>

            <!-- purple square arrow (previous / next day) -->
            <Style x:Key="ApDayButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bd" Background="#6B46E0" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5B3CC4"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#4A2FA8"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- lavender scroll button -->
            <Style x:Key="ApArrowButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="64"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bd" Background="#ECE6FB" BorderBrush="#B9A6EE" BorderThickness="1.2" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E2D9FA"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#D5C8F6"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- purple primary (OK / New Appointment / Update Appointment); the code sets its text, the icon follows it -->
            <Style x:Key="ApPrimaryButton" TargetType="{x:Type Button}">
                <Style.Resources><Style TargetType="{x:Type TextBlock}"/></Style.Resources>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="MinWidth" Value="140"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bd" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7A55E8" Offset="0"/>
                                        <GradientStop Color="#5B3CC4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0">
                                    <Path x:Name="ico" Data="{StaticResource ND.Icon.Plus}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2.4"
                                          Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center">
                                        <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="OK">
                                    <Setter TargetName="ico" Property="Data" Value="{StaticResource ND.Icon.Check}"/>
                                    <Setter TargetName="ico" Property="Width" Value="17"/>
                                </Trigger>
                                <Trigger Property="Content" Value="Update Appointment">
                                    <Setter TargetName="ico" Property="Data" Value="{StaticResource ND.Icon.Check}"/>
                                    <Setter TargetName="ico" Property="Width" Value="17"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.92"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- New design (Book / Recall Appointment): navy header; Calendar, day navigator, Staff; day scheduler; Cancel / OK.
         Names used by the code-behind are unchanged (Title, dtCalendar, prev, next, lbDate, emplkup, lbcnt, pnlschd, schdctrl, pnlstaff,
         btnAdd, btnOK, FullKbd, UpScrollButton, DownScrollButton, blurGrid, ModalWindow). -->
    <Grid Margin="10">
        <cc:ModalWindow x:Name="ModalWindow" Visibility="Collapsed"/>

        <Border CornerRadius="20" Background="#FFFFFF" Effect="{StaticResource ND.ShadowLarge}"/>
        <Border CornerRadius="20" x:Name="dlgBody">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== header ===== -->
                <Grid Grid.Row="0">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E2246" Offset="0"/>
                                <GradientStop Color="#2A2F5C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle HorizontalAlignment="Right" Width="620" Opacity="0.85">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/OfflineRetailV2;component/Resources/Images/LoginStore.jpg"
                                        Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Bottom" Viewbox="0.42,0.78,0.5,0.22"/>
                        </Rectangle.Fill>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Grid Margin="22,0,18,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource ApIconCalendar}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="1.8"
                              Width="30" Height="30" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Text="Title" FontFamily="{StaticResource ND.Font.Bold}" FontSize="23" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtSubtitle" Text="Select an appointment to recall" FontFamily="{StaticResource ND.Font.Regular}" FontSize="13.5" Foreground="#D8DBF0" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ND.DialogCloseButton}" Click="BtnOK_Click" ToolTip="Close"/>
                    </Grid>
                </Grid>

                <!-- ===== Calendar / day navigator / Staff ===== -->
                <Grid Grid.Row="1" Margin="20,14,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.85*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Calendar" Style="{StaticResource ApLabel}"/>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ApField}">
                        <dxe:DateEdit x:Name="dtCalendar" Style="{StaticResource ApEditor}" EditValueChanged="DtCalendar_EditValueChanged" PreviewMouseLeftButtonDown="DtCalendar_PreviewMouseLeftButtonDown"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Height="40" CornerRadius="8" Background="#EEF0F7" BorderBrush="#DDE1EA" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="prev" Style="{StaticResource ApDayButton}" Click="Prev_Click" ToolTip="Previous day">
                                <Path Data="{StaticResource ND.Icon.ChevronLeft}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2.6" Width="9" Height="15"/>
                            </Button>
                            <TextBlock Grid.Column="1" x:Name="lbDate" Text="04/04/2020" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource ND.Font.Medium}" FontSize="15.5" Foreground="#1B1D33" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" x:Name="next" Style="{StaticResource ApDayButton}" Click="Next_Click" ToolTip="Next day">
                                <Path Data="{StaticResource ND.Icon.ChevronRight}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2.6" Width="9" Height="15"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="4" Text="Staff" Style="{StaticResource ApLabel}"/>
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource ApField}">
                        <dxg:LookUpEdit x:Name="emplkup" ItemsSource="{Binding}" Style="{StaticResource ApEditor}"
                                        DisplayMember="EmployeeName"
                                        ValueMember="ID"
                                        AutoPopulateColumns="False"
                                        AutoComplete="True"
                                        IncrementalFiltering="True"
                                        ImmediatePopup="True"
                                        IsPopupAutoWidth="False" EditValueChanged="Emplkup_EditValueChanged"
                                        PreviewMouseLeftButtonDown="Emplkup_PreviewMouseLeftButtonDown"
                                        PopupOpened="gen_PopupOpened">
                            <dxg:LookUpEdit.PopupContentTemplate>
                                <ControlTemplate>
                                    <dxg:GridControl Name="PART_GridControl" AutoGenerateColumns="None">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Image" Visible="False" VisibleIndex="-1" Width="*" AllowAutoFilter="False" Focusable="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ImageEditSettings Stretch="UniformToFill"/>
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="ID" Visible="False" VisibleIndex="-1"/>
                                            <dxg:GridColumn FieldName="EmployeeID" Header="Emp. ID" Visible="True" VisibleIndex="1" />
                                            <dxg:GridColumn FieldName="EmployeeName" Header="Employee" Visible="True" VisibleIndex="2"/>
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <dxg:TableView AutoWidth="True" />
                                        </dxg:GridControl.View>
                                    </dxg:GridControl>
                                </ControlTemplate>
                            </dxg:LookUpEdit.PopupContentTemplate>
                        </dxg:LookUpEdit>
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="No Appointment" x:Name="lbcnt" HorizontalAlignment="Right" Margin="0,6,2,0"
                               FontFamily="{StaticResource ND.Font.SemiBold}" FontSize="12.5" Foreground="#1B1D33"/>
                </Grid>

                <!-- ===== scheduler ===== -->
                <Grid Grid.Row="2" Margin="20,8,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="10" BorderBrush="#DDE2EC" BorderThickness="1" Background="#FFFFFF" ClipToBounds="True">
                        <Grid x:Name="pnlschd">
                    <dxsch:SchedulerControl x:Name="schdctrl"  ActiveViewType="DayView"   AllowAppointmentConflicts="True" AllowAppointmentEdit="False"  AllowAppointmentDragBetweenResources="False" AllowAppointmentCreate="False" AllowAppointmentDelete="False" AllowAppointmentResize="False" AllowCellMultiSelect="False" AllowReminders="False" AllowInplaceEditor="False"  AllowAppointmentDrag="False" MouseDown="Schdctrl_MouseDown"   >
                        <dxsch:SchedulerControl.OptionsWindows>
                            <dxsch:OptionsWindows/>
                        </dxsch:SchedulerControl.OptionsWindows>
                        <dxsch:SchedulerControl.LabelItems>
                            <dxsch:AppointmentLabelItem Id="11" Caption="1" Color="MistyRose"  />
                            <dxsch:AppointmentLabelItem Id="12" Caption="2" Color="Lavender"/>
                            <dxsch:AppointmentLabelItem Id="13" Caption="3" Color="SandyBrown"/>
                            <dxsch:AppointmentLabelItem Id="14" Caption="4" Color="PaleGreen"/>
                            <dxsch:AppointmentLabelItem Id="15" Caption="5" Color="Khaki"/>
                            <dxsch:AppointmentLabelItem Id="16" Caption="6" Color="YellowGreen"/>
                            <dxsch:AppointmentLabelItem Id="17" Caption="7" Color="Turquoise"/>
                            <dxsch:AppointmentLabelItem Id="18" Caption="8" Color="Violet"/>
                            <dxsch:AppointmentLabelItem Id="19" Caption="9" Color="Plum"/>
                            <dxsch:AppointmentLabelItem Id="20" Caption="10" Color="LightPink"/>
                        </dxsch:SchedulerControl.LabelItems>

                        <dxsch:SchedulerControl.DataSource>
                            <dxsch:DataSource>

                                <dxsch:DataSource.ResourceMappings>
                                    <dxsch:ResourceMappings
                                Id="APPTID"
                                Caption="APPT"
                                ></dxsch:ResourceMappings>

                                </dxsch:DataSource.ResourceMappings>
                                <dxsch:DataSource.AppointmentMappings>

                                    <dxsch:AppointmentMappings 
                                Subject="APPTSUB"
                                Description="APPTDET"
                                End="EDATE"
                                Start="SDATE"
                                LabelId="LABEL"
                                ResourceId="APPTID"
                                ></dxsch:AppointmentMappings>
                                </dxsch:DataSource.AppointmentMappings>

                                <dxsch:DataSource.AppointmentLabelsSource>
                                    <dxsch:AppointmentLabelItem Caption="11" Id="11" Color="MistyRose"></dxsch:AppointmentLabelItem>

                                </dxsch:DataSource.AppointmentLabelsSource>
                            </dxsch:DataSource>
                        </dxsch:SchedulerControl.DataSource>
                        <dxsch:DayView ShowDayHeaders="True"  TimeRulerCellStyle="{DynamicResource  DayViewTmRulerStyle}" CellStyle="{DynamicResource DayViewClStyle}" ShowAllDayArea="False"
                   TimeScale="00:10:00" 
                   ShowWorkTimeOnly="False" ShowAppointmentDescription="True" TimeIndicatorVisibility="Always" NavigationButtonsVisibility="Never">
                            <dxsch:DayView.AppointmentContentTemplate>
                                <DataTemplate>
                                    <dxschv:AppointmentContentPanel>
                                        
                                        <dxschv:AppointmentContentPanel.IntervalSubject>
                                            <dxschv:AppointmentIntervalSubjectPresenter FontWeight="Bold" Foreground="Black"/>
                                        </dxschv:AppointmentContentPanel.IntervalSubject>
                                        <dxschv:AppointmentContentPanel.Location>
                                            <dxschv:AppointmentLocationPresenter FontWeight="Normal" Foreground="Blue" />
                                        </dxschv:AppointmentContentPanel.Location>
                                        <dxschv:AppointmentContentPanel.Description>
                                            <StackPanel>
                                                <dxschv:FastTextBlock Text="{Binding Appointment.CustomFields[Note]}" FontWeight="Normal" Foreground="Red"/>
                                                <dxschv:AppointmentDescriptionPresenter FontWeight="Normal" Margin="0,1,0,0" WordWrap="True" Foreground="Black"/>
                                            </StackPanel>
                                        </dxschv:AppointmentContentPanel.Description>
                                        <dxschv:AppointmentContentPanel.Images>
                                            <dxschv:AppointmentImagesPanel/>
                                        </dxschv:AppointmentContentPanel.Images>
                                    </dxschv:AppointmentContentPanel>
                                </DataTemplate>
                            </dxsch:DayView.AppointmentContentTemplate>


                            



                            


                        </dxsch:DayView>
                    </dxsch:SchedulerControl>
                        </Grid>
                    </Border>
                    <Canvas Grid.Row="1" x:Name="pnlstaff" Height="30" Margin="0,6,0,0"></Canvas>
                </Grid>

                <!-- ===== footer ===== -->
                <Grid Grid.Row="3" Margin="20,12,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ApArrowButton}" Margin="0,0,10,0" x:Name="UpScrollButton" Click="UpScrollButton_Click" ToolTip="Scroll up">
                            <Path Data="M5,15 L12,8 L19,15" Style="{StaticResource ND.IconPath}" Stroke="#4A2FA8" StrokeThickness="2.4" Width="15" Height="8"/>
                        </Button>
                        <Button Style="{StaticResource ApArrowButton}" x:Name="DownScrollButton" Click="DownScrollButton_Click" ToolTip="Scroll down">
                            <Path Data="{StaticResource ND.Icon.ChevronDown}" Style="{StaticResource ND.IconPath}" Stroke="#4A2FA8" StrokeThickness="2.4" Width="15" Height="8"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button IsTabStop="False" Focusable="False" Content="KEYBOARD" Style="{StaticResource ND.PosSoftButton}" x:Name="FullKbd" Click="FullKbd_Click" Visibility="Collapsed"/>
                        <Button x:Name="btnOK" Height="46" MinWidth="126" Margin="0,0,12,0" Style="{StaticResource ND.PosSoftButton}" HorizontalContentAlignment="Center" Click="BtnOK_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ND.Icon.Close}" Style="{StaticResource ND.IconPath}" Stroke="#1B1D33" StrokeThickness="2.4" Width="12" Height="12" Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtCloseLabel" Text="Done" VerticalAlignment="Center" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnAdd" Content="New Appointment" Style="{StaticResource ApPrimaryButton}" Click="BtnAdd_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Background="#3D000000" Grid.RowSpan="4" x:Name="blurGrid" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
