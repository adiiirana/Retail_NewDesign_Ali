                                            <dxe:ImageEditSettings Stretch="UniformToFill"/>
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="InvoiceNo" Header="Inv No." Width="*" x:Name="colInv"/>
                                    <dxg:GridColumn FieldName="CustomerID" Header="Cust ID" Width="*" x:Name="colCustID"/>
                                    <dxg:GridColumn FieldName="Customer" Header="Customer" Width="1.4*" x:Name="colCust"/>
                                    <dxg:GridColumn FieldName="Amount" Header="Amount" Width="*" x:Name="colAmount" HorizontalHeaderContentAlignment="Right">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:TextEditSettings DisplayFormat="f" MaskType="Numeric"/>
                                        </dxg:GridColumn.EditSettings>
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:TextEdit x:Name="PART_Editor" Style="{DynamicResource RightAligned}" HorizontalContentAlignment="Right" Margin="0,0,12,0" FontSize="13.5" FontWeight="SemiBold" Mask="f2" MaskType="Numeric" MaskUseAsDisplayFormat="True"></dxe:TextEdit>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>
