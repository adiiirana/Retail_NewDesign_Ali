<Window x:Class="OfflineRetailV2.UserControls.POSSection.frm_POSReturnReprintDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OfflineRetailV2.UserControls.POSSection"
        xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen"
        Title="" Foreground="White"
        Width="1024" Height="740">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/NewDesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="RrIconReceipt">M6,3 H18 V21 L15.5,19.5 L13,21 L10.5,19.5 L8,21 L6,19.5 Z M9,8 H15 M9,11.5 H15 M9,15 H13</Geometry>
            <Geometry x:Key="RrIconReturn">M9,14 L4,9 L9,4 M4,9 H15 A5,5 0 0 1 15,19 H11</Geometry>
            <Geometry x:Key="RrIconVoid">M12,21 A9,9 0 1 0 12,3 A9,9 0 1 0 12,21 Z M5.6,5.6 L18.4,18.4</Geometry>

            <!-- form labels -->
            <Style x:Key="RrLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#1B1D33"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
            <Style x:Key="RrInfo" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Regular}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#4A5068"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <!-- rounded input frame around a DevExpress editor -->
            <Style x:Key="RrField" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderBrush" Value="#C9CEDC"/>
                <Setter Property="BorderThickness" Value="1.2"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Padding" Value="6,0,4,0"/>
            </Style>
            <Style x:Key="RrEditorBase" TargetType="{x:Type dxe:BaseEdit}">
                <Setter Property="ShowBorder" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Regular}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#1B1D33"/>
            </Style>

            <!-- Invoice / Layaway radio: blue filled dot -->
            <Style x:Key="RrRadio" TargetType="{x:Type RadioButton}">
                <Style.Resources><Style TargetType="{x:Type TextBlock}"/></Style.Resources>
                <Setter Property="Foreground" Value="#1B1D33"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Medium}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,34,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                    <Ellipse x:Name="ring" Stroke="#9AA2B8" StrokeThickness="1.6" Fill="#FFFFFF"/>
                                    <Ellipse x:Name="dot" Width="11" Height="11" Fill="#3B6FE0" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ring" Property="Stroke" Value="#3B6FE0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- flat coloured button (Return / Void / Cancel / Print / arrows) -->
            <Style x:Key="RrButton" TargetType="{x:Type Button}">
                <Style.Resources><Style TargetType="{x:Type TextBlock}"/></Style.Resources>
                <Setter Property="Background" Value="#EEF0FA"/>
                <Setter Property="BorderBrush" Value="#C8CCE3"/>
                <Setter Property="Foreground" Value="#1B1D33"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                                    <ContentPresenter.Resources><Style TargetType="{x:Type TextBlock}"/></ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.78"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RrTeal" TargetType="{x:Type Button}" BasedOn="{StaticResource RrButton}">
                <Setter Property="Background" Value="#1E9E95"/>
                <Setter Property="BorderBrush" Value="#1E9E95"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
            <Style x:Key="RrSky" TargetType="{x:Type Button}" BasedOn="{StaticResource RrButton}">
                <Setter Property="Background" Value="#4C9BE8"/>
                <Setter Property="BorderBrush" Value="#4C9BE8"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
            <Style x:Key="RrRed" TargetType="{x:Type Button}" BasedOn="{StaticResource RrButton}">
                <Setter Property="Background" Value="#E05555"/>
                <Setter Property="BorderBrush" Value="#E05555"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>

            <!-- navy grid header -->
            <Style x:Key="RrGridHeader" TargetType="{x:Type dxg:GridColumnHeader}">
                <Setter Property="Background" Value="#26324F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.SemiBold}"/>
                <Setter Property="FontSize" Value="13.5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- New design (Return / Reprint Receipt): navy header with Return / Void / Cancel; Search Criteria card (left)
         and Receipt Records card (right). All names used by the code-behind are unchanged. -->
    <Grid Margin="10">
        <!-- kept for the code-behind (sets its CloseCommand); the visible chrome is drawn below -->
        <cc:ModalWindow x:Name="ModalWindow" Visibility="Collapsed"/>

        <Border CornerRadius="20" Background="#F4F6FB" Effect="{StaticResource ND.ShadowLarge}"/>
        <Border CornerRadius="20" x:Name="dlgBody">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== header ===== -->
                <Grid Grid.Row="0">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E2246" Offset="0"/>
                                <GradientStop Color="#2A2F5C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle HorizontalAlignment="Right" Width="560" Opacity="0.85">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/OfflineRetailV2;component/Resources/Images/LoginStore.jpg"
                                        Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Bottom" Viewbox="0.42,0.78,0.5,0.22"/>
                        </Rectangle.Fill>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Grid Margin="22,0,20,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="12" Background="#FFFFFF" Margin="0,0,16,0">
                            <Path Data="{StaticResource RrIconReceipt}" Style="{StaticResource ND.IconPath}" Stroke="#1E2246" StrokeThickness="1.9" Width="23" Height="27"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Text="Return / Reprint Receipt" FontFamily="{StaticResource ND.Font.Bold}" FontSize="24" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Search receipts, reprint records, or process returns" FontFamily="{StaticResource ND.Font.Regular}" FontSize="13.5" Foreground="#D8DBF0" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- actions (visibility is driven by the code-behind: Invoice vs Layaway, card refunds, tags) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button Content="KEYBOARD" Height="44" MinWidth="104" Visibility="Collapsed" Margin="0,0,10,0"
                                    Style="{StaticResource RrButton}" x:Name="btnKeyboard" Click="btnKeyboard_Click"/>
                            <Button Height="44" MinWidth="104" Visibility="Collapsed" Margin="0,0,10,0" Content="Select Tag Item"
                                    Style="{StaticResource RrButton}" x:Name="btnSelectTag" Click="btnSelectTag_Click"/>
                            <Button Height="44" MinWidth="108" Margin="0,0,10,0" Style="{StaticResource RrTeal}" x:Name="btnReturn" Click="btnReturn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RrIconReturn}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2" Width="17" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Return" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="44" MinWidth="98" Margin="0,0,10,0" Style="{StaticResource RrSky}" x:Name="btnVoid" Click="btnVoid_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RrIconVoid}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2" Width="17" Height="17" Margin="0,0,8,0"/>
                                    <TextBlock Text="Void" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="44" MinWidth="108" Margin="0,0,10,0" Style="{StaticResource RrTeal}" x:Name="btnRefundLayAway" Click="btnRefundLayAway_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RrIconReturn}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2" Width="17" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Refund" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="44" MinWidth="120" Visibility="Collapsed" Margin="0,0,10,0" Content="Refund (Card)"
                                    Style="{StaticResource RrTeal}" x:Name="RefundButton" Click="RefundButton_Click"/>
                            <Button Height="44" MinWidth="110" Visibility="Collapsed" Margin="0,0,10,0" Content="Void (Card)"
                                    Style="{StaticResource RrSky}" x:Name="VoidReceipt" Click="VoidReceipt_Click"/>
                            <!-- the Print action lives at the bottom of Search Criteria (btnPrint1); this one is kept for the code -->
                            <Button Height="44" Width="100" Visibility="Collapsed" Content="Print"
                                    Style="{StaticResource RrButton}" x:Name="btnPrint" Click="btnPrint_Click"/>
                            <Button Height="44" MinWidth="104" Style="{StaticResource RrRed}" x:Name="btnCancel" Click="BtnCancel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ND.Icon.Close}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2.2" Width="11" Height="11" Margin="0,0,9,0"/>
                                    <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource ND.DialogCloseButton}" Click="BtnCancel_Click" ToolTip="Close"/>
                    </Grid>
                </Grid>

                <!-- ===== body ===== -->
                <Grid Grid.Row="1" Margin="18,16,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.92*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Search Criteria ===== -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E1E6F0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="#EDE9FB" CornerRadius="13,13,0,0" BorderBrush="#DCD5F5" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource ND.Icon.Search}" Style="{StaticResource ND.IconPath}" Stroke="#5B3CC4" StrokeThickness="2" Width="15" Height="15" Margin="0,0,10,0"/>
                                    <TextBlock Text="Search Criteria" FontFamily="{StaticResource ND.Font.SemiBold}" FontSize="15" Foreground="#4A2FA8"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="16,12,16,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="Invoice" x:Name="rg1" Checked="rg1_Checked" Style="{StaticResource RrRadio}"/>
                                        <RadioButton Content="Layaway" x:Name="rg2" Checked="rg1_Checked" Style="{StaticResource RrRadio}"/>
                                    </StackPanel>

                                    <TextBlock Text="Invoice #" x:Name="lbInv" Style="{StaticResource RrLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource RrField}" BorderBrush="#4A8FD9" BorderThickness="1.5">
                                            <dxe:TextEdit x:Name="txtInv" Style="{StaticResource RrEditorBase}" FontSize="15"
                                                          PreviewKeyDown="txtInv_PreviewKeyDown" GotFocus="Num_GotFocus" LostFocus="Num_LostFocus"/>
                                        </Border>
                                        <Button Grid.Column="1" Height="40" Width="92" Margin="10,0,0,0" Style="{StaticResource RrSky}"
                                                x:Name="btnKeyEnter" Click="btnKeyEnter_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Enter" VerticalAlignment="Center"/>
                                                <Path Data="{StaticResource ND.Icon.ArrowRight}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" StrokeThickness="2" Width="14" Height="12" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- receipt / customer info filled by the code-behind -->
                                    <StackPanel Margin="2,8,0,10">
                                        <TextBlock Text="" x:Name="lbReceipt" Style="{StaticResource RrInfo}" FontFamily="{StaticResource ND.Font.Medium}" Foreground="#1B1D33"/>
                                        <TextBlock Text="" x:Name="lbCustCompany" Style="{StaticResource RrInfo}"/>
                                        <TextBlock Text="" x:Name="lbCustName" Style="{StaticResource RrInfo}"/>
                                        <TextBlock Text="" x:Name="lbCustID" Style="{StaticResource RrInfo}"/>
                                    </StackPanel>

                                    <TextBlock Text="Show receipts with this SKU" Style="{StaticResource RrLabel}"/>
                                    <Border Style="{StaticResource RrField}" Margin="0,0,0,12">
                                        <dxg:LookUpEdit x:Name="cmbP" ItemsSource="{Binding}" Style="{StaticResource RrEditorBase}"
                                                        DisplayMember="Description"
                                                        ValueMember="ID"
                                                        AutoPopulateColumns="False"
                                                        AutoComplete="True"
                                                        IncrementalFiltering="True"
                                                        ImmediatePopup="True"
                                                        IsPopupAutoWidth="False" EditValueChanged="CmbP_EditValueChanged"
                                                        PreviewMouseLeftButtonDown="CmbP_PreviewMouseLeftButtonDown" PopupOpened="gen_PopupOpened" >
                                            <dxg:LookUpEdit.PopupContentTemplate>
                                                <ControlTemplate>
                                                    <dxg:GridControl Name="PART_GridControl" AutoGenerateColumns="None">
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="Image" Visible="False" VisibleIndex="-1" Width="*" AllowAutoFilter="False" Focusable="False">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:ImageEditSettings Stretch="UniformToFill"/>
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn FieldName="ID" Visible="False" VisibleIndex="-1"/>
                                                            <dxg:GridColumn FieldName="Description" Header="Description" Visible="True" VisibleIndex="1" />
                                                            <dxg:GridColumn FieldName="SKU" Header="SKU" Visible="True" VisibleIndex="2"/>
                                                            <dxg:GridColumn FieldName="Cost" Header="Cost" Visible="True" VisibleIndex="3"/>
                                                            <dxg:GridColumn FieldName="PrintBarCode" Header="Print BarCode" Visible="False" VisibleIndex="-1"/>
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TableView AutoWidth="True" />
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </dxg:LookUpEdit.PopupContentTemplate>
                                        </dxg:LookUpEdit>
                                    </Border>

                                    <TextBlock Text="Show receipts for this Customer" Style="{StaticResource RrLabel}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- store picker: only visible with central export/import -->
                                        <Border Style="{StaticResource RrField}" Width="110" Margin="0,0,10,0"
>
                                            <dxe:ComboBoxEdit x:Name="cmbStore" Style="{StaticResource RrEditorBase}"
                                                              SelectedIndexChanged="cmbStore_SelectedIndexChanged" PreviewMouseLeftButtonDown="CmbStore_PreviewMouseLeftButtonDown"/>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource RrField}">
                                            <dxg:LookUpEdit x:Name="cmbC" ItemsSource="{Binding}" Style="{StaticResource RrEditorBase}"
                                                            DisplayMember="LastName"
                                                            ValueMember="ID"
                                                            AutoPopulateColumns="False"
                                                            AutoComplete="True"
                                                            IncrementalFiltering="True"
                                                            ImmediatePopup="True"
                                                            IsPopupAutoWidth="False" EditValueChanged="CmbC_EditValueChanged"
                                                            PreviewMouseLeftButtonDown="CmbP_PreviewMouseLeftButtonDown" PopupOpened="gen_PopupOpened" >
                                                <dxg:LookUpEdit.PopupContentTemplate>
                                                    <ControlTemplate>
                                                        <dxg:GridControl Name="PART_GridControl" AutoGenerateColumns="None">
                                                            <dxg:GridControl.Columns>
                                                                <dxg:GridColumn FieldName="Image" Visible="False" VisibleIndex="-1" Width="*" AllowAutoFilter="False" Focusable="False">
                                                                    <dxg:GridColumn.EditSettings>
                                                                        <dxe:ImageEditSettings Stretch="UniformToFill"/>
                                                                    </dxg:GridColumn.EditSettings>
                                                                </dxg:GridColumn>
                                                                <dxg:GridColumn FieldName="ID" Visible="False" VisibleIndex="-1"/>
                                                                <dxg:GridColumn FieldName="CustomerID" Header="Cust. ID" Visible="True" VisibleIndex="1" />
                                                                <dxg:GridColumn FieldName="FirstName" Header="First Name" Visible="True" VisibleIndex="2"/>
                                                                <dxg:GridColumn FieldName="LastName" Header="Last Name" Visible="True" VisibleIndex="3"/>
                                                            </dxg:GridControl.Columns>
                                                            <dxg:GridControl.View>
                                                                <dxg:TableView AutoWidth="True" />
                                                            </dxg:GridControl.View>
                                                        </dxg:GridControl>
                                                    </ControlTemplate>
                                                </dxg:LookUpEdit.PopupContentTemplate>
                                            </dxg:LookUpEdit>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Show receipts for this Employee" Style="{StaticResource RrLabel}"/>
                                    <Border Style="{StaticResource RrField}" Margin="0,0,0,12">
                                        <dxg:LookUpEdit x:Name="cmbE" ItemsSource="{Binding}" Style="{StaticResource RrEditorBase}"
                                                        DisplayMember="Name"
                                                        ValueMember="ID"
                                                        AutoPopulateColumns="False"
                                                        AutoComplete="True"
                                                        IncrementalFiltering="True"
                                                        ImmediatePopup="True"
                                                        IsPopupAutoWidth="False" EditValueChanged="CmbE_EditValueChanged"
                                                        PreviewMouseLeftButtonDown="CmbP_PreviewMouseLeftButtonDown" PopupOpened="gen_PopupOpened" >
                                            <dxg:LookUpEdit.PopupContentTemplate>
                                                <ControlTemplate>
                                                    <dxg:GridControl Name="PART_GridControl" AutoGenerateColumns="None">
                                                        <dxg:GridControl.Columns>
                                                            <dxg:GridColumn FieldName="Image" Visible="False" VisibleIndex="-1" Width="*" AllowAutoFilter="False" Focusable="False">
                                                                <dxg:GridColumn.EditSettings>
                                                                    <dxe:ImageEditSettings Stretch="UniformToFill"/>
                                                                </dxg:GridColumn.EditSettings>
                                                            </dxg:GridColumn>
                                                            <dxg:GridColumn FieldName="ID" Visible="False" VisibleIndex="-1"/>
                                                            <dxg:GridColumn FieldName="EmployeeID" Header="Emp. ID" Visible="True" VisibleIndex="1" />
                                                            <dxg:GridColumn FieldName="Name" Header="Employee" Visible="True" VisibleIndex="2"/>
                                                        </dxg:GridControl.Columns>
                                                        <dxg:GridControl.View>
                                                            <dxg:TableView AutoWidth="True" />
                                                        </dxg:GridControl.View>
                                                    </dxg:GridControl>
                                                </ControlTemplate>
                                            </dxg:LookUpEdit.PopupContentTemplate>
                                        </dxg:LookUpEdit>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date" Style="{StaticResource RrLabel}"/>
                                        <TextBlock Grid.Column="2" Text="Amount" Style="{StaticResource RrLabel}"/>

                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource RrField}">
                                            <dxe:ComboBoxEdit x:Name="cmbDate" SelectedIndex="0" IsTextEditable="False" Style="{StaticResource RrEditorBase}"
                                                              SelectedIndexChanged="cmbDate_SelectedIndexChanged" PreviewMouseLeftButtonDown="CmbStore_PreviewMouseLeftButtonDown">
                                                <dxe:ComboBoxEditItem>Today</dxe:ComboBoxEditItem>
                                                <dxe:ComboBoxEditItem>Between</dxe:ComboBoxEditItem>
                                                <dxe:ComboBoxEditItem>None</dxe:ComboBoxEditItem>
                                            </dxe:ComboBoxEdit>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource RrField}">
                                            <dxe:ComboBoxEdit x:Name="cmbAmount" SelectedIndex="0" IsTextEditable="False" Style="{StaticResource RrEditorBase}"
                                                              SelectedIndexChanged="cmbAmount_SelectedIndexChanged" PreviewMouseLeftButtonDown="CmbStore_PreviewMouseLeftButtonDown">
                                                <dxe:ComboBoxEditItem>None</dxe:ComboBoxEditItem>
                                                <dxe:ComboBoxEditItem>Greater than</dxe:ComboBoxEditItem>
                                                <dxe:ComboBoxEditItem>Less than</dxe:ComboBoxEditItem>
                                                <dxe:ComboBoxEditItem>Between</dxe:ComboBoxEditItem>
                                            </dxe:ComboBoxEdit>
                                        </Border>

                                        <!-- From / To values: shown by the code-behind when "Between" / "Greater than" etc. is picked -->
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource RrField}" Margin="0,8,0,0">
                                            <dxe:DateEdit x:Name="dtF" Style="{StaticResource RrEditorBase}" EditValueChanged="dtF_EditValueChanged" PreviewMouseLeftButtonDown="DtF_PreviewMouseLeftButtonDown"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource RrField}" Margin="0,8,0,0">
