                                <dxg:GridControl ShowBorder="False" x:Name="grdHeader" FontFamily="{StaticResource ND.Font.Regular}" FontSize="13.5"
                                                 MouseDown="grdHeader_MouseDown" StartSorting="grdHeader_StartSorting" EndSorting="grdHeader_EndSorting">
                                    <dxg:GridControl.Resources>
                                        <Style TargetType="{x:Type dxg:GridColumnHeader}" BasedOn="{StaticResource RrGridHeader}"/>
                                    </dxg:GridControl.Resources>
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="gridView2" NavigationStyle="Row" FocusedRowChanged="gridView2_FocusedRowChanged"
                                                       PreviewMouseDoubleClick="gridView2_PreviewMouseDoubleClick"
                                                       AutoWidth="True" ShowGroupPanel="False" ShowIndicator="False" ShowVerticalLines="False" RowMinHeight="36">
                                            <dxg:TableView.FormatConditions>
                                                <dxg:FormatCondition FieldName="VoidNo" Expression="[IsVoid] != 'Y'" ApplyToRow="True">
                                                    <dx:Format Background="DarkRed" Foreground="#DADADA"></dx:Format>
                                                </dxg:FormatCondition>
                                            </dxg:TableView.FormatConditions>
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="Image" Visible="False" VisibleIndex="-1" Width="*" AllowAutoFilter="False" Focusable="False">
