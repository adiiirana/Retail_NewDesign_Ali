                                    </Button>
                                    <Button Style="{StaticResource RrButton}" Width="70" Height="38" x:Name="btnDownDetail" Click="BtnDownDetail_Click" ToolTip="Next">
                                        <Path Data="{StaticResource ND.Icon.ChevronDown}" Style="{StaticResource ND.IconPath}" Stroke="#1B1D33" StrokeThickness="2.2" Width="15" Height="8"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Background="#3D000000" Grid.RowSpan="2" x:Name="blurGrid" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
