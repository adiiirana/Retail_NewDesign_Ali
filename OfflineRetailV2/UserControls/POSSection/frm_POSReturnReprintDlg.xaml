                                    <dxg:GridColumn FieldName="ReturnItemID" Header="ReturnItemID" Width="*" x:Name="colRID" Visible="False"/>
                                    <dxg:GridColumn FieldName="CheckReturned" Header="Return" Width="0.7*" x:Name="colCheck" AllowEditing="True" AllowFocus="True">
