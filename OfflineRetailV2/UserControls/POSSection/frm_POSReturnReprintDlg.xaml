                            </Button>
                        </Grid>
                    </Border>

                    <!-- ===== Receipt Records ===== -->
                    <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E1E6F0" BorderThickness="1">
