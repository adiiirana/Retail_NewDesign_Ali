                                    <dxg:GridColumn FieldName="TaxRate1" Header="gridColumn34" Width="*" x:Name="gridColumn34" Visible="False"/>
                                    <dxg:GridColumn FieldName="TaxRate2" Header="gridColumn35" Width="*" x:Name="gridColumn35" Visible="False"/>
