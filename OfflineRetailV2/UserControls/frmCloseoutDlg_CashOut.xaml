<UserControl x:Class="OfflineRetailV2.UserControls.frmCloseoutDlg_CashOut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OfflineRetailV2.UserControls"
              xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
         xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
          xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar"
             Loaded="UserControl_Loaded_1"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             IsVisibleChanged="UserControl_IsVisibleChanged_1"

 MinWidth="900" MinHeight="400"    >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/NewDesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TileIconBox" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="52"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Margin" Value="0,0,18,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource ND.PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="168"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Hero: welcome + date, photo with curved edge, Exit ===================== -->
        <Grid Grid.Row="0" Background="#FFFFFF" ClipToBounds="True">
            <Path Stretch="Fill" Fill="#ECF5FB" VerticalAlignment="Bottom" Height="70"
                  Data="M0,40 C200,0 420,10 640,40 L640,70 L0,70 Z"/>
            <!-- Photo on the right with a curved left edge -->
            <Grid HorizontalAlignment="Right" Width="380">
                <Grid.Clip>
                    <PathGeometry Figures="M380,0 L120,0 C40,60 160,140 0,168 L380,168 Z"/>
                </Grid.Clip>
                <Rectangle Fill="{StaticResource ND.LoginPhotoHero}"/>
                <Rectangle Fill="#1A26324F"/>
            </Grid>

            <StackPanel VerticalAlignment="Center" Margin="30,0,0,10">
                <TextBlock FontSize="31" Foreground="{StaticResource ND.TextDark}" FontFamily="{StaticResource ND.Font.Regular}">
                    <Run Text="Welcome,"/>
                    <Run x:Name="txtWelcomeName" Text="" FontFamily="{StaticResource ND.Font.SemiBold}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                    <Path Data="{StaticResource ND.Icon.Calendar}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.TextMuted}" Width="13" Height="13" StrokeThickness="1.6"/>
                    <TextBlock x:Name="txtDateTime" Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource ND.TextMuted}" FontFamily="{StaticResource ND.Font.Regular}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="btnCancel" Style="{StaticResource ND.OutlineButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="96" Height="40" Margin="0,18,30,0" Click="BtnCancel_Click" ToolTip="Close Manage Register and sign out">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource ND.Icon.Power}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" Width="13" Height="13"/>
                    <TextBlock Text="Exit" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===================== View options ===================== -->
        <Grid Grid.Row="1" Margin="30,16,30,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButton Content="Consolidated" Grid.Column="0" x:Name="rg1" GroupName="0" Style="{StaticResource ND.Radio}"/>
            <RadioButton Content="By Terminal" Grid.Column="1" x:Name="rg2" GroupName="0" Style="{StaticResource ND.Radio}"/>

            <dxe:ComboBoxEdit Grid.Column="3"
              x:Name="cmbSaleType"
              Width="150"
              Height="36"
              IsTextEditable="False"
              SelectedIndex="0"
              SelectedIndexChanged="CmbSaleType_SelectedIndexChanged"
              FontFamily="{StaticResource ND.Font.Medium}" FontSize="13" Foreground="#FFFFFF" Background="{StaticResource ND.Purple}" BorderThickness="0" BorderBrush="Transparent">
                <dxe:ComboBoxEditItem Content="Counter Sale"/>
                <dxe:ComboBoxEditItem Content="Account Sale"/>
            </dxe:ComboBoxEdit>

            <dxg:LookUpEdit Grid.Column="5" x:Name="lkup" Width="220" Height="36"
                    Background="#FFFFFF" BorderBrush="{StaticResource ND.Border}" BorderThickness="1"
                    FontFamily="{StaticResource ND.Font.Regular}" FontSize="13" Foreground="{StaticResource ND.TextDark}"
                    ItemsSource="{Binding}" AutoComplete="True"
                    IncrementalFiltering="True"
                    ImmediatePopup="True"
                    AutoPopulateColumns="False"
                    IsPopupAutoWidth="False"
                    PreviewMouseLeftButtonDown="Lkup_PreviewMouseLeftButtonDown"
                    PopupOpened="gen_PopupOpened">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <dxg:GridControl Name="PART_GridControl" AutoGenerateColumns="None">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="ID" Visible="False" />
                                <dxg:GridColumn FieldName="Terminal" Header="Terminal" VisibleIndex="0" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True" ShowColumnHeaders="False" />
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>
        </Grid>

        <!-- ===================== Action tiles (collapsed tiles drop out of the grid) ===================== -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="22,4,22,0" x:Name="pnlTiles">
            <Button x:Name="btnBD" Style="{StaticResource ND.Tile}" BorderBrush="{StaticResource ND.Blue}" Click="BtnBD_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TileIconBox}" Background="{StaticResource ND.BlueTint}">
                        <Path Data="{StaticResource ND.Icon.Swap}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Blue}" Width="24" Height="20"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cash In / Out" Style="{StaticResource ND.TileTitle}"/>
                        <TextBlock Text="Record cash movements" Style="{StaticResource ND.TileSubtitle}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button x:Name="btnBC" Style="{StaticResource ND.Tile}" BorderBrush="{StaticResource ND.Purple}" Click="BtnBC_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TileIconBox}" Background="{StaticResource ND.PurpleTint}">
                        <Path Data="{StaticResource ND.Icon.Report}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Purple}" Width="20" Height="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="X Report" Style="{StaticResource ND.TileTitle}"/>
                        <TextBlock Text="Print the current shift report" Style="{StaticResource ND.TileSubtitle}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button x:Name="btnRC" Style="{StaticResource ND.Tile}" BorderBrush="{StaticResource ND.Orange}" Click="BtnRC_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TileIconBox}" Background="{StaticResource ND.OrangeTint}">
                        <Path Data="{StaticResource ND.Icon.AreaChart}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Orange}" Width="22" Height="20"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Z Report" Style="{StaticResource ND.TileTitle}"/>
                        <TextBlock Text="Print the end of day report" Style="{StaticResource ND.TileSubtitle}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button x:Name="btnReprint" Style="{StaticResource ND.Tile}" BorderBrush="{StaticResource ND.Teal}" Click="BtnReprint_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TileIconBox}" Background="{StaticResource ND.TealTint}">
                        <Path Data="{StaticResource ND.Icon.Printer}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.Teal}" Width="22" Height="22"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reprint" Style="{StaticResource ND.TileTitle}"/>
                        <TextBlock Text="Reprint receipts and documents" Style="{StaticResource ND.TileSubtitle}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <!-- Not in the design, kept so blind / reconcile counts stay reachable -->
            <Button x:Name="btnEdit" Style="{StaticResource ND.Tile}" BorderBrush="{StaticResource ND.NavyButton}" Click="BtnEdit_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource TileIconBox}" Background="{StaticResource ND.KeyBg}">
                        <Path Data="{StaticResource ND.Icon.Edit}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.NavyButton}" Width="20" Height="20"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Edit Count" Style="{StaticResource ND.TileTitle}"/>
                        <TextBlock Text="Blind drop, blind and reconcile counts" Style="{StaticResource ND.TileSubtitle}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- ===================== Print toggle ===================== -->
        <CheckBox Grid.Row="3" x:Name="chkReceiptPrinter" Style="{StaticResource ND.ToggleSwitch}" Content="Print in Receipt Printer"
                  HorizontalAlignment="Left" Margin="32,10,0,10"/>

        <!-- ===================== Register bar ===================== -->
        <Button Grid.Row="4" x:Name="btnOpenRegister" Style="{StaticResource ND.RegisterBarButton}" Margin="30,0,30,18" Click="BtnOpenRegister_Click">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource ND.Icon.Lock}" Style="{StaticResource ND.IconPath}" Stroke="#FFFFFF" Width="15" Height="18"/>
                <TextBlock Text="Open Register" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Grid Background="#3D000000" Grid.RowSpan="5" x:Name="blurGrid" Visibility="Collapsed"/>
    </Grid>
</UserControl>
