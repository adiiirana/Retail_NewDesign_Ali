<UserControl x:Class="OfflineRetailV2.UserControls.frmCloseoutDlg_CashOut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OfflineRetailV2.UserControls"
              xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
        xmlns:lm="clr-namespace:OfflineRetailV2.LayoutManager"
         xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
          xmlns:dxn="http://schemas.devexpress.com/winfx/2008/xaml/navbar"
             Loaded="UserControl_Loaded_1"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             IsVisibleChanged="UserControl_IsVisibleChanged_1"
 MinWidth="900" MinHeight="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/NewDesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TileIconBox" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="64"/>
                <Setter Property="Height" Value="64"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Margin" Value="0,0,20,0"/>
            </Style>
            <Style x:Key="MrTileTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ND.TileTitle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontFamily" Value="{StaticResource ND.Font.Bold}"/>
                <Setter Property="FontSize" Value="21"/>
                <Setter Property="Foreground" Value="#1B1D33"/>
            </Style>
            <Style x:Key="MrTileSub" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ND.TileSubtitle}">
                <Setter Property="FontSize" Value="14.5"/>
                <Setter Property="Foreground" Value="#6B7089"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextTrimming" Value="None"/>
            </Style>
            <Geometry x:Key="MrIconRegister">M4,13 H20 V20 H4 Z M5.5,13 L7,8 H17 L18.5,13 M9,8 V4 H15 V8 M8,16.5 H16</Geometry>
            <Geometry x:Key="MrIconDatabase">M4,6 A8,3 0 1 0 20,6 A8,3 0 1 0 4,6 Z M4,6 V18 A8,3 0 0 0 20,18 V6 M4,12 A8,3 0 0 0 20,12</Geometry>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- New design (Manage Register): hero with store image, Counter Sale selector, 3 x 2 action tiles,
         Print in Receipt Printer switch. "Exit" lives in the main header (MainWindow.btnHeaderExit). -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F4F6FB" Offset="0"/>
                <GradientStop Color="#E9EDF6" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Hero ===================== -->
        <Grid Grid.Row="0" ClipToBounds="True">
            <!-- store photo on the right, fading into the page on the left -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.4*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="1">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="pack://application:,,,/OfflineRetailV2;component/Resources/Images/LoginStore.jpg"
                                Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#B0000000" Offset="0.45"/>
                        <GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Column="1" Fill="#2EFFFFFF"/>

            <Grid Grid.ColumnSpan="2" Margin="42,34,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="64" Height="64" CornerRadius="14" Background="#E6E8F3" VerticalAlignment="Top">
                    <Path Data="{StaticResource MrIconRegister}" Style="{StaticResource ND.IconPath}" Stroke="#2F3460" StrokeThickness="2" Width="30" Height="28"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Manage Register" FontFamily="{StaticResource ND.Font.Bold}" FontSize="34" Foreground="#1B1D33"/>
                    <TextBlock Text="Register controls, cash movements and end-of-day actions." FontFamily="{StaticResource ND.Font.Regular}" FontSize="17"
                               Foreground="#4B4F6B" Margin="0,2,0,0"/>
                </StackPanel>
                <Rectangle Grid.Row="1" Width="64" Height="4" RadiusX="2" RadiusY="2" Fill="#F2A93B" HorizontalAlignment="Left" Margin="0,20,0,0"/>
            </Grid>
        </Grid>

        <!-- ===================== View options + sale type ===================== -->
        <Grid Grid.Row="1" Margin="42,6,42,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButton Content="Consolidated" Grid.Column="0" x:Name="rg1" GroupName="0" Style="{StaticResource ND.Radio}"/>
            <RadioButton Content="By Terminal" Grid.Column="1" x:Name="rg2" GroupName="0" Style="{StaticResource ND.Radio}"/>

            <dxg:LookUpEdit Grid.Column="3" x:Name="lkup" Width="230" Height="42"
                    Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="1"
                    FontFamily="{StaticResource ND.Font.Regular}" FontSize="14" Foreground="#1B1D33"
                    ItemsSource="{Binding}" AutoComplete="True"
                    IncrementalFiltering="True"
                    ImmediatePopup="True"
                    AutoPopulateColumns="False"
                    IsPopupAutoWidth="False"
                    PreviewMouseLeftButtonDown="Lkup_PreviewMouseLeftButtonDown"
                    PopupOpened="gen_PopupOpened">
                <dxg:LookUpEdit.PopupContentTemplate>
                    <ControlTemplate>
                        <dxg:GridControl Name="PART_GridControl" AutoGenerateColumns="None">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="ID" Visible="False" />
                                <dxg:GridColumn FieldName="Terminal" Header="Terminal" VisibleIndex="0" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AutoWidth="True" ShowColumnHeaders="False" />
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </ControlTemplate>
                </dxg:LookUpEdit.PopupContentTemplate>
            </dxg:LookUpEdit>

            <!-- Counter Sale / Account Sale (shown when wholesale is active) -->
            <dxe:ComboBoxEdit Grid.Column="5"
              x:Name="cmbSaleType"
              Width="255"
              Height="42"
              IsTextEditable="False"
              SelectedIndex="0"
              SelectedIndexChanged="CmbSaleType_SelectedIndexChanged"
              FontFamily="{StaticResource ND.Font.SemiBold}" FontSize="17" Foreground="#FFFFFF" Background="#9A60A5"
              BorderThickness="0" BorderBrush="Transparent" Padding="10,0,0,0">
                <dxe:ComboBoxEditItem Content="Counter Sale"/>
                <dxe:ComboBoxEditItem Content="Account Sale"/>
            </dxe:ComboBoxEdit>
        </Grid>

        <!-- ===================== Action tiles (3 x 2; hidden tiles drop out) ===================== -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="32,8,32,0" x:Name="pnlTiles" VerticalAlignment="Top">
            <Button x:Name="btnBD" Style="{StaticResource ND.Tile}" BorderBrush="#3DB6ED" Height="140" Click="BtnBD_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIconBox}" Background="#E8F7FC">
                        <Path Data="{StaticResource ND.Icon.Swap}" Style="{StaticResource ND.IconPath}" Stroke="#3DB6ED" StrokeThickness="2" Width="28" Height="24"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cash In / Out" Style="{StaticResource MrTileTitle}"/>
                        <TextBlock Text="Record cash movements" Style="{StaticResource MrTileSub}"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="btnBC" Style="{StaticResource ND.Tile}" BorderBrush="#9A60A5" Height="140" Click="BtnBC_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIconBox}" Background="#F3ECF7">
                        <Path Data="{StaticResource ND.Icon.Report}" Style="{StaticResource ND.IconPath}" Stroke="#9A60A5" StrokeThickness="2" Width="24" Height="28"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="X Report" Style="{StaticResource MrTileTitle}"/>
                        <TextBlock Text="Print the current shift report" Style="{StaticResource MrTileSub}"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="btnRC" Style="{StaticResource ND.Tile}" BorderBrush="#E8961C" Height="140" Click="BtnRC_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIconBox}" Background="#FFF3E2">
                        <Path Data="{StaticResource ND.Icon.AreaChart}" Style="{StaticResource ND.IconPath}" Stroke="#E8961C" StrokeThickness="2" Width="28" Height="26"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Z Report" Style="{StaticResource MrTileTitle}"/>
                        <TextBlock Text="Print the end of day report" Style="{StaticResource MrTileSub}"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="btnReprint" Style="{StaticResource ND.Tile}" BorderBrush="#2AA7A1" Height="140" Click="BtnReprint_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIconBox}" Background="#E4F6F4">
                        <Path Data="{StaticResource ND.Icon.Printer}" Style="{StaticResource ND.IconPath}" Stroke="#2AA7A1" StrokeThickness="2" Width="28" Height="28"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Reprint" Style="{StaticResource MrTileTitle}"/>
                        <TextBlock Text="Reprint receipts and documents" Style="{StaticResource MrTileSub}"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="btnEdit" Style="{StaticResource ND.Tile}" BorderBrush="#2F3460" Height="140" Click="BtnEdit_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIconBox}" Background="#E9EBF3">
                        <Path Data="{StaticResource ND.Icon.Edit}" Style="{StaticResource ND.IconPath}" Stroke="#2F3460" StrokeThickness="2" Width="26" Height="26"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Amend Closeout" Style="{StaticResource MrTileTitle}"/>
                        <TextBlock Text="Blind drop, blind and reconcile counts" Style="{StaticResource MrTileSub}"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="btnTillSummary" Style="{StaticResource ND.Tile}" BorderBrush="#F2B705" Height="140" Click="BtnTillSummary_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIconBox}" Background="#FFF7DC">
                        <Path Data="{StaticResource MrIconDatabase}" Style="{StaticResource ND.IconPath}" Stroke="#E3A008" StrokeThickness="2" Width="26" Height="28"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Till Summary" Style="{StaticResource MrTileTitle}"/>
                        <TextBlock Text="Review current register totals" Style="{StaticResource MrTileSub}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </UniformGrid>

        <!-- ===================== Print switch + Open Register ===================== -->
        <Grid Grid.Row="3" Margin="44,14,42,20">
            <CheckBox x:Name="chkReceiptPrinter" Style="{StaticResource ND.ToggleSwitch}" Content="Print in Receipt Printer"
                      HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16"/>
            <!-- shown by code only when registers are opened per terminal -->
            <Button x:Name="btnOpenRegister" Style="{StaticResource ND.OutlineNavyButton}" Height="46" MinWidth="190" HorizontalAlignment="Right"
                    Click="BtnOpenRegister_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource ND.Icon.Lock}" Style="{StaticResource ND.IconPath}" Stroke="#26324F" Width="14" Height="17" Margin="0,0,9,0"/>
                    <TextBlock Text="Open Register" VerticalAlignment="Center" FontSize="15"/>
                </StackPanel>
            </Button>
            <!-- closing / signing out is the header "Exit" button; kept for code references -->
            <Button x:Name="btnCancel" Visibility="Collapsed" Click="BtnCancel_Click"/>
        </Grid>

        <Grid Background="#3D000000" Margin="-15" Grid.RowSpan="5" x:Name="blurGrid" Visibility="Collapsed"/>
    </Grid>
</UserControl>
