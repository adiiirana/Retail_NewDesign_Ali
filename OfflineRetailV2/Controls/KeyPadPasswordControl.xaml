<UserControl x:Class="OfflineRetailV2.Controls.KeyPadPasswordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="clr-namespace:OfflineRetailV2.Controls"
             xmlns:local="clr-namespace:OfflineRetailV2.Controls"
             xmlns:prop="clr-namespace:OfflineRetailV2.Properties">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/NewDesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PassDot" TargetType="{x:Type Ellipse}">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Margin" Value="7,0"/>
                <Setter Property="Fill" Value="#D3D9E3"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- New design: white card, "Enter Passcode" header, passcode box with 4 dots, 4x3 keypad.
         Bottom-left key (menu) raises MenuRequested; with no subscriber it clears the passcode. -->
    <Border Background="#FFFFFF" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="11"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="29"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource ND.Icon.Lock}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.TextDark}" Width="14" Height="17"/>
                <TextBlock Text="{x:Static prop:Resources.EnterPassCode}" Margin="10,0,0,0" FontSize="16"
                           FontFamily="{StaticResource ND.Font.SemiBold}" Foreground="{StaticResource ND.TextDark}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="2" Height="52" CornerRadius="8" Background="{StaticResource ND.InputBg}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource PassDot}" x:Name="Pass1"/>
                    <Ellipse Style="{StaticResource PassDot}" x:Name="Pass2"/>
                    <Ellipse Style="{StaticResource PassDot}" x:Name="Pass3"/>
                    <Ellipse Style="{StaticResource PassDot}" x:Name="Pass4"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <!-- DockPanel wrappers keep the original touch handling (PreviewMouseLeftButtonDown) -->
                <DockPanel Grid.Row="0" Grid.Column="0" PreviewMouseLeftButtonDown="KeyPad1_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad1" Content="1"/>
                </DockPanel>
                <DockPanel Grid.Row="0" Grid.Column="2" PreviewMouseLeftButtonDown="KeyPad2_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad2" Content="2"/>
                </DockPanel>
                <DockPanel Grid.Row="0" Grid.Column="4" PreviewMouseLeftButtonDown="KeyPad3_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad3" Content="3"/>
                </DockPanel>
                <DockPanel Grid.Row="2" Grid.Column="0" PreviewMouseLeftButtonDown="KeyPad4_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad4" Content="4"/>
                </DockPanel>
                <DockPanel Grid.Row="2" Grid.Column="2" PreviewMouseLeftButtonDown="KeyPad5_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad5" Content="5"/>
                </DockPanel>
                <DockPanel Grid.Row="2" Grid.Column="4" PreviewMouseLeftButtonDown="KeyPad6_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad6" Content="6"/>
                </DockPanel>
                <DockPanel Grid.Row="4" Grid.Column="0" PreviewMouseLeftButtonDown="KeyPad7_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad7" Content="7"/>
                </DockPanel>
                <DockPanel Grid.Row="4" Grid.Column="2" PreviewMouseLeftButtonDown="KeyPad8_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad8" Content="8"/>
                </DockPanel>
                <DockPanel Grid.Row="4" Grid.Column="4" PreviewMouseLeftButtonDown="KeyPad9_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad9" Content="9"/>
                </DockPanel>

                <cc:CustomButton Grid.Row="6" Grid.Column="0" Style="{StaticResource ND.KeyButton}" x:Name="CancelButton" Click="CancelButton_Click" ToolTip="More options">
                    <Path Data="{StaticResource ND.Icon.Menu}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.TextDark}" Width="20" Height="14"/>
                </cc:CustomButton>
                <DockPanel Grid.Row="6" Grid.Column="2" PreviewMouseLeftButtonDown="KeyPad0_Click" Background="Transparent">
                    <cc:CustomButton Style="{StaticResource ND.KeyButton}" x:Name="KeyPad0" Content="0"/>
                </DockPanel>
                <cc:CustomButton Grid.Row="6" Grid.Column="4" Style="{StaticResource ND.KeyButton}" x:Name="DeleteButton" Click="DeleteButton_Click" ToolTip="Back Space">
                    <Path Data="{StaticResource ND.Icon.Backspace}" Style="{StaticResource ND.IconPath}" Stroke="{StaticResource ND.TextDark}" Width="22" Height="16"/>
                </cc:CustomButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
